{
  "name": "vaines-shop",
  "version": "1.0.0",
  "description": "Cloudflare Pages shop with Etsy integration",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev ./public --port 8788 --compatibility-date=2024-01-01",
    "dev:watch": "run-p watch:*",
    "watch:hugo": "hugo server --buildDrafts --buildFuture --disableFastRender --destination public --watch",
    "watch:wrangler": "wrangler pages dev ./public --port 8788 --compatibility-date=2024-01-01",
    "build": "hugo --destination public",
    "lint": "eslint functions/**/*.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-miniflare-youch.mjs"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "hugo",
    "etsy",
    "shop"
  ],
  "author": "Aiden Vaines",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "npm-run-all2": "^7.0.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.64.0"
  }
}
