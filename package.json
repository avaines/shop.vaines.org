{
  "name": "vaines-shop",
  "version": "1.0.0",
  "description": "Cloudflare Pages shop with Etsy integration",
  "type": "module",
  "scripts": {
    "build": "npm run build:pages && npm run build:worker",
    "build:pages": "cd pages && hugo --destination public",
    "build:worker": "cd worker && wrangler deploy --dry-run",
    "dev": "run-p dev:pages dev:worker",
    "dev:pages": "cd pages && hugo server --buildDrafts --buildFuture --disableFastRender --destination public --port 1313",
    "dev:worker": "cd worker && wrangler dev --port 8788",
    "deploy": "npm run deploy:pages && npm run deploy:worker",
    "deploy:pages": "cd pages && wrangler pages deploy public",
    "deploy:worker": "cd worker && wrangler deploy",
    "lint": "npm run lint:pages && npm run lint:worker",
    "lint:pages": "echo 'No linting for pages (Hugo templates)'",
    "lint:worker": "cd worker && eslint '**/*.js'",
    "test": "npm run test:pages && npm run test:worker",
    "test:pages": "vitest run pages/tests",
    "test:worker": "vitest run worker/tests",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "pages",
    "hugo",
    "etsy",
    "shop"
  ],
  "author": "Aiden Vaines",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "npm-run-all2": "^7.0.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.64.0"
  }
}
